# Copy this file to .env.local and fill in real values there.
# Never put real credentials in this .example file — it's the one that
# tends to get committed or shared by mistake.

MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
MONGODB_DB=portfolio

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-char-app-password
